{
  "name": "snag-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted session replay that finds the bugs in your app for you, then hands them to your coding agent to fix.",
  "license": "MIT",
  "workspaces": [
    "packages/shared",
    "packages/detectors",
    "packages/sdk",
    "packages/ingest",
    "packages/dashboard"
  ],
  "scripts": {
    "build": "npm run build -w @snag/shared -w @snag/detectors -w @snag/sdk -w @snag/ingest && npm run build -w @snag/dashboard",
    "build:libs": "npm run build -w @snag/shared -w @snag/detectors -w @snag/sdk -w @snag/ingest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:ingest": "npm run dev -w @snag/ingest",
    "dev:dashboard": "npm run dev -w @snag/dashboard",
    "demo": "node examples/demo-app/serve.mjs",
    "check:prose": "node scripts/check-prose.mjs",
    "check": "npm run typecheck && npm test && npm run check:prose"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/saakshigupta2002/snag#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saakshigupta2002/snag.git"
  },
  "bugs": {
    "url": "https://github.com/saakshigupta2002/snag/issues"
  },
  "keywords": [
    "session-replay",
    "self-hosted",
    "bug-detection",
    "rrweb",
    "analytics",
    "privacy",
    "observability"
  ]
}
